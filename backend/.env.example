# PostgreSQL (docker-compose, konteynerin 5432 portunu hostta 5433e eşler)
# 127.0.0.1 bilinçli: Windows'ta "localhost" IPv6 ::1'e çözülüyor ve
# Docker port eşlemesi orada dinlemiyor; bağlantı sessizce kopuyor.
DATABASE_URL=postgres://beauty:beauty@127.0.0.1:5433/beauty_ingredient?sslmode=disable

# Sunucu
PORT=8090
GIN_MODE=debug

# API yi çağırabilecek tarayıcı kaynakları (virgülle ayrılır); "*" tümüne izin verir
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Faz 2 ---
# OPENAI_API_KEY=
# VISION_API_KEY=
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC_PRICE_UPDATES=product-prices
